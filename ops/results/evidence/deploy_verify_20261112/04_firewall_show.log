table inet grid {
	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state established,related accept
		ip saddr 10.10.1.0/24 ip daddr 10.10.2.10 tcp dport 8443 counter packets 0 bytes 0 accept comment "meters to API over TLS"
		ip saddr 10.10.1.0/24 ip daddr 10.10.2.10 tcp dport 5201 counter packets 0 bytes 0 accept comment "iperf3 throughput tests"
		ip saddr 10.10.1.0/24 ip daddr 10.10.2.0/24 icmp type echo-request counter packets 0 bytes 0 accept comment "ping meters to API"
		ip saddr 10.10.2.10 ip daddr 10.10.3.10 tcp dport 27017 counter packets 0 bytes 0 accept comment "API to MongoDB"
		ip saddr 10.10.2.0/24 ip daddr 10.10.3.0/24 icmp type echo-request counter packets 0 bytes 0 accept comment "ping API to DB"
		ip saddr 10.10.1.0/24 ip daddr 10.10.3.0/24 counter packets 0 bytes 0 drop comment "DENY meters to DB"
		counter packets 0 bytes 0 comment "other dropped traffic"
	}
}
